(footprint "AOP_ALP180_DieThermalPad"
	(version 20241229)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Board-only exposed GND thermal pad under the IWR6843AOP (ALP0180A) under-mounted die, same outline on F.Cu and B.Cu, solder mask open, no paste. Origin = package centre; place at U300's position and rotation. Die per SWRS237C p.84: 7.1 mm along the column axis, 0.37 mm toward column 1 (local -X), 6.94 mm along the row axis (F.Fab outline). Pad = die cut back to local X >= -2.59 with a 2.01 mm chamfer at local (-X,-Y) so existing U300 escape copper keeps >= 0.25 mm. TI practice: SWRA672 section 5, Figs 17-20.")
	(tags "IWR6843AOP ALP0180A AOP thermal pad exposed copper")
	(property "Reference" "REF**"
		(at 0 -5.5 0)
		(layer "F.Fab")
